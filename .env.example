# ====================================================================
# SEO Intelligence - Environment Configuration Template
# ====================================================================
# Copy this file to `.env` and fill in your custom values:
#   cp .env.example .env

# --- Security & Auth ---
# Secret key used for JWT signing and verification.
# Generate a secure key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=your_jwt_secret_key_here

# --- Database & Storage ---
# SQLite default: file:data/seo_auditor.db (or postgresql://user:pass@host:5432/dbname)
DATABASE_URL=file:data/seo_auditor.db

# --- Queue & Worker (Redis) ---
# Optional: If Redis is not available, audits run synchronously in an in-memory thread pool.
REDIS_URL=redis://localhost:6379/0

# --- Frontend & CORS ---
FRONTEND_URL=http://localhost:5173

# ====================================================================
# Optional Third-Party Service API Keys
# (Users can supply their own keys for extended live data integrations)
# ====================================================================

# Google Gemini API Key (for AI recommendations & AI Assistant)
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenPageRank API Key (for live Domain Authority & PageRank scoring)
# Get a free API key at: https://www.domcop.com/openpagerank/auth/signup
OPEN_PAGERANK_API_KEY=

# Keywords Everywhere API Key (for search volume and CPC data)
# Get an API key at: https://keywordseverywhere.com/api.html
KEYWORD_EVERYWHERE_API_KEY=

# YouTube Data API v3 Key (for YouTube SERP rankings)
# Get a key at: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO